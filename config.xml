<?xml version='1.0' encoding='utf-8'?>
<widget id="dz.boukhelifa.exammanager" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
  <name>تسيير الاختبارات الفصلية</name>
  <description>تطبيق لتسيير الاختبارات الفصلية وتوزيع الحراسة والقاعات.</description>
  <author email="" href="">Boukhelifa Mohamed</author>
  <content src="index.html" />
  <access origin="*" />
  <allow-navigation href="*" />
  <preference name="Orientation" value="landscape" />
  <preference name="Fullscreen" value="false" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="android-targetSdkVersion" value="35" />
  <preference name="AndroidXEnabled" value="true" />
  <icon src="res/icon.png" />
  <platform name="android">
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
      <application android:usesCleartextTraffic="true" android:hardwareAccelerated="true" />
    </edit-config>
  </platform>
</widget>
